<Page x:Class="GUIYael.shoppingBasket"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F8F9FA" FlowDirection="RightToLeft" Title="shoppingBasket"
      UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="White" CornerRadius="12" Margin="30" Padding="20" Width="320" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="Gray" Opacity="0.1"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="🛒 סל הקניות שלך" FontSize="24" FontWeight="SemiBold" Foreground="#2D3436" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                <StackPanel x:Name="stpMeals" Margin="0,0,0,15"/>

                <Separator Background="#EFEFEF" Margin="0,10"/>

                <UniformGrid Columns="2" Margin="0,5">
                    <TextBlock Text="סך הכל לתשלום:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBox x:Name="sumPrice" Width="90" Height="28" TextAlignment="Center" FontSize="14" 
                             Background="#F1F3F5" BorderThickness="0" VerticalContentAlignment="Center" 
                             HorizontalAlignment="Left" IsReadOnly="True" IsTabStop="False"/>
                </UniformGrid>

                <UniformGrid Columns="2" Margin="0,5,0,20">
                    <TextBlock Text="סך כל המנות:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBox x:Name="sumMeal" Width="90" Height="28" TextAlignment="Center" FontSize="14" 
                             Background="#F1F3F5" BorderThickness="0" VerticalContentAlignment="Center" 
                             HorizontalAlignment="Left" IsReadOnly="True" IsTabStop="False"/>
                </UniformGrid>

                <Button Content="בצע הזמנה מהירה" Click="Button_Click" FontSize="16" FontWeight="SemiBold" Background="#2ECC71" Foreground="White" Height="42" Cursor="Hand" BorderThickness="0"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>