<Page x:Class="GUIYael.AddHall"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:GUIYael"
      mc:Ignorable="d"
      FlowDirection="RightToLeft"
      Background="#F5F7FA"
      Title="AddHall">

    <Grid>

        <Border Width="520"
                Background="White"
                CornerRadius="18"
                Padding="30"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- כותרת -->
                    <TextBlock Text="הוספת אולם חדש"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30"
                               Foreground="#2C3E50"/>

                    <!-- שם -->
                    <TextBlock Text="שם האולם"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Name}"
                             Height="40"
                             FontSize="15"
                             Margin="0,0,0,18"/>

                    <!-- עיר -->
                    <TextBlock Text="עיר"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <ComboBox Name="cmbCities"
                              DisplayMemberPath="NameCity"
                              SelectedItem="{Binding city}"
                              Height="40"
                              Margin="0,0,0,18"/>

                    <!-- רחוב -->
                    <TextBlock Text="רחוב"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}"
                             Height="40"
                             Margin="0,0,0,18"/>

                    <!-- מספר בית -->
                    <TextBlock Text="מספר בית"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <TextBox Text="{Binding HouseNumber, UpdateSourceTrigger=PropertyChanged}"
                             Height="40"
                             Margin="0,0,0,18"/>

                    <!-- מחיר -->
                    <TextBlock Text="מחיר"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Price}"
                             Height="40"
                             Margin="0,0,0,18"/>

                 
                    <TextBlock Text="כמות מקומות"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Amount}"
                             Height="40"
                             Margin="0,0,0,25"/>

                    <TextBlock Text="מספר טלפון"
                   FontWeight="SemiBold"
                   Margin="0,0,0,5"/>
                    <TextBox Text="{Binding CellPhone}"
                 Height="40"
                 Margin="0,0,0,25"/>

                    <Border Background="#F8F9FB"
                            CornerRadius="12"
                            Padding="15"
                            Margin="0,0,0,25">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="📁 צרף תמונה"
                                    Click="Button_Click_1"
                                    Height="42"
                                    Background="#4F46E5"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"/>

                            <Border Grid.Column="1"
                                    Width="90"
                                    Height="90"
                                    CornerRadius="10"
                                    BorderBrush="#D6D6D6"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center">

                                <Image x:Name="MyIMG"
                                       Stretch="UniformToFill"/>

                            </Border>

                        </Grid>

                    </Border>

                    <!-- שמירת אולם -->
                    <Button Content="הוספה"
                            Click="BtnSave_Click"
                            Height="48"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Background="#2E8B57"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</Page>









