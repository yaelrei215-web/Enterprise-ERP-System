    <Page x:Class="GUIYael.PLogin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GUIYael"
      mc:Ignorable="d" 
      Background="#F8F9FA" 
      FlowDirection="RightToLeft"
      Title="PLogin">

    <Grid>
        <Border Background="White" 
                CornerRadius="20" 
                Padding="50" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center" 
                Width="450">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="2" Color="#E2E2E2" Opacity="0.5"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="🔐"  FontSize="50"    HorizontalAlignment="Center" 
                           Margin="0,0,0,20"/>
                <TextBlock Text="כניסה למערכת"  FontSize="32" 
                           FontWeight="Light"   Foreground="#2D3436" HorizontalAlignment="Center" 
                           Margin="0,0,0,10"/>
                
                <TextBlock Text="שמחים שבחרתם בנו !" FontSize="15"
                           Foreground="#A4B0BE"   HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <TextBlock Text="מספר תעודת זהות" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#636E72"/>
                <TextBox x:Name="txtTZ" Height="50" FontSize="18" Background="#FBFBFC" BorderBrush="#DFE6E9"
                   Margin="0,0,0,20" VerticalContentAlignment="Center"/>

                <TextBlock Text="סיסמה" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#636E72"/>
                <PasswordBox x:Name="txtPass" Height="50" FontSize="18" Background="#FBFBFC" BorderBrush="#DFE6E9"
                             VerticalContentAlignment="Center" Margin="0,0,0,30"/>

                <Button Content="התחברות" 
                        FontSize="18" 
                        FontWeight="SemiBold"  Background="#2D3436"   Foreground="White"  Height="55" 
                        Cursor="Hand"   BorderThickness="0" Click="Button_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="לכניסה ללא הרשמה" FontSize="13" Foreground="#0984E3" HorizontalAlignment="Center" Margin="0,20,0,0"
                        Click="Button_Click_2" Background="Transparent" BorderThickness="0"/>
                <Button Content="להרשמה לחץ כאן" FontSize="13" Foreground="#0984E3" HorizontalAlignment="Center" Margin="0,10,0,0"
                        Click="Button_Click_1" Background="Transparent" BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>