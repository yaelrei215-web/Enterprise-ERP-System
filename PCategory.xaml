<Page x:Class="GUIYael.PCategory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Background="#F8F9FA" 
      FlowDirection="RightToLeft"
      Title="PCategory">

    <Grid>
        <Border Background="White"  CornerRadius="20"  Padding="40" 
                VerticalAlignment="Center"   HorizontalAlignment="Center"  Width="450">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="2" Color="#E2E2E2" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="הוספת קטגוריה חדשה" 
                           FontSize="28"    FontWeight="Light"   Foreground="#2D3436" 
                           Margin="0,0,0,10"     HorizontalAlignment="Center"/>

                <TextBlock Text="הקש שם קטגוריה:" 
                           FontSize="15"      Foreground="#A4B0BE"    Margin="0,0,0,25" 
                           HorizontalAlignment="Center"/>

                <TextBox Text="{Binding NameCategory}" Width="300" 
                         Height="50"     FontSize="18" VerticalContentAlignment="Center" 
                         Margin="0,0,0,30"  Background="#FBFBFC"  BorderBrush="#DFE6E9"/>

                <Button Content="אישור ושמירה" 
                        Click="Button_Click"   Height="50" 
                        Width="200"    Background="#2D3436" 
                        Foreground="White" 
                        FontWeight="SemiBold"   FontSize="16" 
                        Cursor="Hand" 
                        BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>