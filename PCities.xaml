<Page x:Class="GUIYael.PCities"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F8F9FA" FlowDirection="RightToLeft" Title="PCities">

    <StackPanel Margin="20" HorizontalAlignment="Center" Width="260">

        <TextBlock Text="📍 ניהול ערים" FontSize="22" FontWeight="SemiBold" Foreground="#2D3436" Margin="0,0,0,15" HorizontalAlignment="Center"/>

        <Border Background="White" CornerRadius="10" Padding="5" BorderBrush="#EFEFEF" BorderThickness="1">
            <ListView Name="lstvCities" Background="Transparent" BorderThickness="0" MaxHeight="250">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Height" Value="35"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="שם העיר" DisplayMemberBinding="{Binding NameCity}" Width="220"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

    </StackPanel>
</Page>