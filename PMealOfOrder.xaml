<Page x:Class="GUIYael.PMealOfOrder"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GUIYael"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PMealOfOrder">



    <StackPanel Background="#F5F5F5" >
        <ListView x:Name="lstMeals"  FlowDirection="RightToLeft"  Background="White"   BorderBrush="#DDDDDD" BorderThickness="1" FontSize="14">

            <ListView.View>
                <GridView>
                    <GridViewColumn Header="שם המנה" DisplayMemberBinding="{Binding Meal.NameMeal}" Width="160"/>

                    <GridViewColumn Header="כמות" DisplayMemberBinding="{Binding Count}"   Width="80"/>
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>

</Page>
