<Page x:Class="GUIYael.PDataOrder"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F8F9FA" FlowDirection="RightToLeft" Title="PDataOrder"
      UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="White" CornerRadius="15" Margin="30" Padding="25" Width="380" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="Gray" Opacity="0.1"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="📄 סיכום הזמנה" FontSize="26" FontWeight="SemiBold" Foreground="#2D3436" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <UniformGrid Columns="2" Margin="0,4">
                    <TextBlock Text="מספר הזמנה:" Foreground="Gray"/>
                    <TextBlock x:Name="id" FontWeight="Bold" HorizontalAlignment="Left"/>
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,4">
                    <TextBlock Text="שם הלקוח:" Foreground="Gray"/>
                    <TextBlock x:Name="User" FontWeight="Bold" Foreground="#0984E3" HorizontalAlignment="Left"/>
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,4,0,15">
                    <TextBlock Text="עיר המגורים:" Foreground="Gray"/>
                    <TextBlock x:Name="CityName" FontWeight="Bold" HorizontalAlignment="Left"/>
                </UniformGrid>

                <Separator Background="#EFEFEF" Margin="0,10"/>

                <ListView x:Name="lstMeals" Background="Transparent" BorderThickness="0" FontSize="14" MaxHeight="200" Margin="0,5">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="🍽️ שם המנה" DisplayMemberBinding="{Binding Meal.NameMeal}" Width="210"/>
                            <GridViewColumn Header="📦 כמות" DisplayMemberBinding="{Binding Count}" Width="80"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Separator Background="#EFEFEF" Margin="0,10"/>

                <UniformGrid Columns="2" Margin="0,5,0,25">
                    <TextBlock Text="סה''כ לתשלום:" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="sumPrice" FontSize="22" FontWeight="Bold" Foreground="#2ECC71" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </UniformGrid>

                <StackPanel HorizontalAlignment="Center" Margin="0,10,0,5">
                    <TextBlock Text="תודה שבחרת בנו! ❤️" FontSize="16" FontWeight="Medium" Foreground="#636E72" HorizontalAlignment="Center"/>
                    <TextBlock Text="נשמח לקחת חלק באירוע שלכם" FontSize="12" Foreground="#B2BEC3" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>