<Page x:Class="GUIYael.PFinishOrderHall"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GUIYael"
      mc:Ignorable="d" 
      Background="#F8F9FA" FlowDirection="RightToLeft"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="PFinishOrderHall"
      UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="White" CornerRadius="15" Margin="30" Padding="30" Width="400" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="Gray" Opacity="0.1"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="📄 אישור הזמנת אולם" FontSize="24" FontWeight="Bold" Foreground="#2D3436" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="מספר הזמנה:" Foreground="#888888" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding IdOrderHall}" FontWeight="SemiBold" Foreground="#2D3436" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="שם הלקוח:" Foreground="#888888" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding USER.LastName}" FontWeight="Bold" Foreground="#0984E3" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="תאריך האירוע:" Foreground="#888888" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding EventDate, StringFormat=\{0:dd/MM/yyyy\}}" FontWeight="SemiBold" Foreground="#2D3436" VerticalAlignment="Center"/>
                </Grid>

                <Separator Background="#EFEFEF" Margin="0,15"/>

                <TextBlock Text="🏰 פרטי האולם המוזמן" FontSize="15" FontWeight="Bold" Foreground="#2D3436" Margin="0,5,0,12" HorizontalAlignment="Right"/>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="שם האולם:" Foreground="#888888" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Hall.Name}" FontWeight="SemiBold" Foreground="#2D3436" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="עיר:" Foreground="#888888" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Hall.city.NameCity}" Foreground="#2D3436" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="רחוב:" Foreground="#888888" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Hall.Street}" Foreground="#2D3436" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="מספר בית:" Foreground="#888888" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Hall.HouseNumber}" Foreground="#2D3436" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="כמות מוזמנים מקסימלית:" Foreground="#888888" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Hall.Amount}" Foreground="#2D3436" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="טלפון האולם:" Foreground="#888888" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Hall.CellPhone}" Foreground="#2D3436" VerticalAlignment="Center"/>
                </Grid>

                <Separator Background="#EFEFEF" Margin="0,15"/>

                <Grid Margin="0,10,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="סה''כ שולם:" FontSize="18" FontWeight="SemiBold" Foreground="#2D3436" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="₪ " FontSize="18" FontWeight="Bold" Foreground="#2ECC71" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Hall.Price, StringFormat=\{0:N0\}}" FontSize="22" FontWeight="Bold" Foreground="#2ECC71" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <StackPanel HorizontalAlignment="Center" Margin="0,10,0,5">
                    <TextBlock Text="תודה שאתם חוגגים איתנו! ❤️" FontSize="16" FontWeight="Medium" Foreground="#636E72" HorizontalAlignment="Center"/>
                    <TextBlock Text="נשמח לקחת חלק באירוע המרגש שלכם" FontSize="12" Foreground="#B2BEC3" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>















