<Page x:Class="GUIYael.POrder"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F8F9FA" FlowDirection="RightToLeft" Title="POrder"
      xmlns:local="clr-namespace:GUIYael"
      UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">


    <!-- סגנון משותף ועדין לכל תיבות הטקסט (TextBox) בעמוד -->
    <Page.Resources>

        <local:ValidationDate x:Key="ValidationDate"/>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#434752"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- סגנון עדין ומעוגל ל-ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- כרטיס תשלום מרכזי רחב ומאוזן יותר (רוחב 420) -->
        <Border Background="White" CornerRadius="20" Margin="25,40" Padding="25" Width="420" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Color="#000000" Opacity="0.05"/>
            </Border.Effect>

            <StackPanel>
                <!-- כותרת ראשית -->
                <TextBlock Text="🛍️ סיכום ותשלום ההזמנה" FontSize="20" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <StackPanel x:Name="Order" Visibility="Visible">

                    <!-- בלוק סיכום כספי ומנות - רקע בהיר ועדין -->
                    <Border Background="#F9FAFB" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <UniformGrid Columns="2" Margin="0,2">
                                <TextBlock Text="סך הכל לתשלום:" FontSize="13" Foreground="#666666" VerticalAlignment="Center"/>
                                <TextBlock x:Name="price" FontSize="15" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Left"/>
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,4,0,2">
                                <TextBlock Text="סך כל המנות:" FontSize="13" Foreground="#666666" VerticalAlignment="Center"/>
                                <TextBlock x:Name="numMeal" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A" HorizontalAlignment="Left"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- בחירת אירוע ושעה -->
                    <TextBlock Text="בחר אחד מהאירועים שנרשמת" FontSize="12" FontWeight="SemiBold" Foreground="#757575" Margin="0,0,0,5"/>
                    <ComboBox Name="cmbDates" Margin="0,0,0,12" SelectionChanged="cmbDates_SelectionChanged"/>

                    <TextBlock Text="שעת האירוע:" FontSize="12" FontWeight="SemiBold" Foreground="#757575" Margin="0,0,0,5"/>
                    <TextBox Name="txtReadyTime" Margin="0,0,0,16"/>

                    <!-- פרטי הכתובת והאולם (שדות קריאה בלבד מעוצבים בעדינות) -->
                    <TextBlock Text="מיקום ופרטי האולם" FontSize="12" FontWeight="SemiBold" Foreground="#757575" Margin="0,0,0,6"/>
                    <Border BorderBrush="#F0F0F0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16" Background="#FAFAFA">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="שם האולם: " FontSize="13" Foreground="#666666"/>
                                <TextBlock x:Name="name" Grid.Column="1" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A" HorizontalAlignment="Left"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="עיר: " FontSize="13" Foreground="#666666"/>
                                <TextBlock x:Name="city" Grid.Column="1" FontSize="13" Foreground="#1A1A1A" HorizontalAlignment="Left"/>
                            </Grid>

                            <UniformGrid Columns="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="רחוב: " FontSize="13" Foreground="#666666"/>
                                    <TextBlock x:Name="street" FontSize="13" Foreground="#1A1A1A" FontWeight="Medium"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock Text="מס' בית: " FontSize="13" Foreground="#666666"/>
                                    <TextBlock x:Name="number" FontSize="13" Foreground="#1A1A1A" FontWeight="Medium"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- פרטי זיהוי (ת"ז וסיסמה זה לצד זה) -->
                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="תעודת זהות" FontSize="12" Foreground="#555555" Margin="0,0,0,4"/>
                            <TextBox x:Name="tz"/>
                        </StackPanel>
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="סיסמה" FontSize="12" Foreground="#555555" Margin="0,0,0,4"/>
                            <TextBox x:Name="password"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- פרטי אשראי (מספר כרטיס ותוקף) -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.3*"/>
                            <ColumnDefinition Width="1.7*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="10,10,10,0" HorizontalAlignment="Left">
                            <TextBlock Text="מספר כרטיס" FontSize="12" Foreground="#555555" Margin="0,0,0,4"/>
                            <TextBox x:Name="numberCard" Width="150"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,10,10,0" HorizontalAlignment="Left">
                            <TextBlock Text="תוקף (MM/YY)" FontSize="12" Foreground="#555555" Margin="0,0,0,4"/>
                            <TextBox x:Name="expdate" MaxLength="5" Width="80" ToolTip="הזינו בפורמט חודש/שנה (למשל: 12/26)">
                                <Binding Path="ExperationDate">
                                    <Binding.ValidationRules>
                                        <local:ValidationDate/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Margin="10,80,10,0" HorizontalAlignment="Left">
                            <TextBlock Text="שלוש ספרות (CVV)" FontSize="12" Foreground="#555555" Margin="0,0,0,4"/>
                            <TextBox x:Name="cvv" MaxLength="3" Width="60" ToolTip="3 ספרות בגב הכרטיס"/>
                        </StackPanel>
                    </Grid>

                    <!-- כפתור אישור ותשלום יוקרתי בצבע פחם מודרני -->
                    <Button Content="אישור וביצוע תשלום" 
                            Click="Button_Click" 
                            FontSize="14" 
                            FontWeight="SemiBold" 
                            Height="42" 
                            Cursor="Hand" 
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2A2D34"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#434752"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#1A1B20"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- כפתור צפייה בהזמנה (במידה ומופיע) -->
                <Button Content="👁️ לצפייה בהזמנה" 
                        x:Name="seeOrder" 
                        Visibility="Collapsed" 
                        Click="seeOrder_Click" 
                        FontSize="13" 
                        Height="38" 
                        Cursor="Hand" 
                        BorderThickness="1"
                        BorderBrush="#CCCCCC"
                        Margin="0,12,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#555555"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>

