<Page x:Class="GUIYael.PAvelibele"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GUIYael"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="PAvelibele"
      Background="#F8F9FA">

    <Grid>
        <Border Background="#FFFFFF"
                CornerRadius="24"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="400"
                BorderBrush="#EAEAEA"
                BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="5"
                                  Color="#000000"
                                  Opacity="0.05"/>
            </Border.Effect>

            <StackPanel FlowDirection="RightToLeft">

                <TextBlock Text="לוח זמנים" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="#1A1A1A" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>

                <TextBlock Text="בחרו תאריך פנוי לבדיקת זמינות" 
                           FontSize="14" 
                           Foreground="#757575" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <Border BorderBrush="#EAEAEA" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="5"
                        Background="#FFFFFF"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,25">

                    <Calendar Name="HallCalendar" 
                              DisplayMode="Month" 
                              SelectionMode="SingleDate"/>
                </Border>

                <Button Content="להמשך לתשלום" 
                        Click="Button_Click" 
                        Height="44" 
                        Width="220"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        HorizontalAlignment="Center"
                        BorderThickness="0">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2A2D34"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#434752"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#1A1B20"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Page>


