<Page x:Class="GUIYael.PCity"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:GUIYael"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="PCity">

    <Grid Background="#F5F6F8">
        <Border Width="500" Padding="35" Background="White"
                CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                  ShadowDepth="2"   Color="#CFCFCF" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="🏙️"
                 FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="עיר חדשה"  FontSize="30"
                   FontWeight="Light" Foreground="#2D3436" HorizontalAlignment="Center"/>
                <Border Width="70" Height="4"
                        Background="#5BC0DE"   CornerRadius="2"  HorizontalAlignment="Center"
                        Margin="0,10,0,20"/>

                <TextBlock Text="הזן את שם העיר שברצונך להוסיף"
                           FontSize="15"  Foreground="#8A97A0" HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <TextBlock Text="שם העיר"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#636E72"  Margin="0,0,0,8"/>

                <Border Background="#FAFAFA" BorderBrush="#E2E5E8"
                        BorderThickness="1" CornerRadius="10">

                    <TextBox Text="{Binding NameCity}"
                             Height="45"  FontSize="16" Background="Transparent"
                             BorderThickness="0" Padding="12,0" VerticalContentAlignment="Center"/>
                </Border>

                <Button Content="אישור ושמירה"
                        Click="Button_Click" Height="50"
                        Margin="0,25,0,0" Background="#2F363D"  Foreground="White"  
                        FontSize="16"   FontWeight="SemiBold"   Cursor="Hand" BorderThickness="0">

                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                  </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>